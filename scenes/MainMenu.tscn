[node name="AboutText" type="Label" parent="AboutPanel/Center/Box"]
layout_mode = 2
custom_minimum_size = Vector2(1300, 0)
autowrap_mode = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 30
text = "«Экзамен завтра» — небольшая 2D-игра о знакомой каждому студенту ситуации: до экзамена осталось всего 12 часов, а ты практически ничего не выучил.\n\nТвоя задача — продержаться до 9 утра, подготовиться к экзамену и не уснуть раньше времени. В твоём распоряжении учебник, ноутбук, кровать и несколько порций кофе. Но всё не так просто: силы заканчиваются, сосед мешает заниматься, а ночь постепенно подходит к концу.\n\nРаспределяй время, принимай решения, следи за своей бодростью и постарайся успеть выучить достаточно, чтобы сдать экзамен.\n\nПомни: кофе не заменяет знания, а сон — роскошь, которую ты не можешь себе позволить.\n\nУдачи. Она тебе понадобится!"

